# Local development configuration. Copy to .env and adjust only if needed.
PROJECT_NAME=nyc-taxi-lakehouse
LOG_LEVEL=INFO
DATA_DIR=/workspace/data
# Development-only MinIO credentials. Replace for any non-local deployment.
MINIO_ROOT_USER=lakehouse_dev
MINIO_ROOT_PASSWORD=local_development_only_change_me
MINIO_ENDPOINT=http://minio:9000
MINIO_BUCKET=nyc-taxi-lakehouse
STORAGE_BACKEND=filesystem
# Local-only Airflow metadata and UI credentials; change for any non-local use.
POSTGRES_USER=airflow_dev
POSTGRES_PASSWORD=local_development_only_change_me
POSTGRES_DB=airflow_metadata
AIRFLOW_ADMIN_USER=admin
AIRFLOW_ADMIN_PASSWORD=local_development_only_change_me
AIRFLOW_ADMIN_EMAIL=admin@localhost
AIRFLOW__WEBSERVER__SECRET_KEY=local_development_only_change_me
