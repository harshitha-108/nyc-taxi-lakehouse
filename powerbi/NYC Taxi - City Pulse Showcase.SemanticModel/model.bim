          }
        ],
        "lineageTag": "8b36344e-8e97-410a-bd9b-7fe717bc50cf",
        "measures": [
          {
            "name": "Avg Trip Distance (mi)",
            "expression": "DIVIDE(SUM(daily_trip_metrics[total_trip_distance]), SUM(daily_trip_metrics[trip_count]))",
            "formatString": "0.00",
            "lineageTag": "fdf54f89-bfcc-4e3f-8d10-c2d443350ade"
          },
          {
            "name": "Avg Trip Duration (min)",
            "expression": "DIVIDE(SUMX(daily_trip_metrics, daily_trip_metrics[average_trip_duration_minutes] * daily_trip_metrics[trip_count]), SUM(daily_trip_metrics[trip_count]))",
            "formatString": "0.00",
            "lineageTag": "bab485a2-e379-4e9f-aee6-fc815def6f2b"
          },
          {
            "name": "Busiest Pickup Hour",
            "expression": "VAR Hours = SUMMARIZE('hourly_demand', 'hourly_demand'[pickup_hour], \"Trips\", SUM('hourly_demand'[trip_count])) VAR Winner = TOPN(1, Hours, [Trips], DESC, 'hourly_demand'[pickup_hour], ASC) VAR H = MAXX(Winner, 'hourly_demand'[pickup_hour]) RETURN FORMAT(TIME(H, 0, 0), \"h AM/PM\")",
            "lineageTag": "b10a5cad-2002-4819-932f-a906ec3ca65e"
          },
          {
            "name": "Top Pickup Borough",
            "expression": "VAR Boroughs = SUMMARIZE('pickup_zone_performance', 'pickup_zone_performance'[borough], \"Trips\", SUM('pickup_zone_performance'[trip_count])) VAR Winner = TOPN(1, Boroughs, [Trips], DESC, 'pickup_zone_performance'[borough], ASC) RETURN MAXX(Winner, 'pickup_zone_performance'[borough])",
            "lineageTag": "3a54d38e-01cd-4f4c-a360-d2335b36927d"
          },
          {
            "name": "Most Used Payment Method",
            "expression": "VAR Payments = SUMMARIZE('payment_type_summary', 'payment_type_summary'[payment_type], \"Trips\", SUM('payment_type_summary'[trip_count])) VAR Winner = TOPN(1, Payments, [Trips], DESC, 'payment_type_summary'[payment_type], ASC) VAR Code = MAXX(Winner, 'payment_type_summary'[payment_type]) RETURN SWITCH(Code, 0, \"Flex Fare trip\", 1, \"Credit card\", 2, \"Cash\", 3, \"No charge\", 4, \"Dispute\", 5, \"Unknown\", 6, \"Voided trip\", \"Code \" & FORMAT(Code, \"0\"))",
            "lineageTag": "c47b8d23-5264-49a5-829e-7e0b3640b4f7"
          },
          {
            "name": "Avg Total per Trip (USD)",
            "expression": "DIVIDE(SUM(daily_trip_metrics[total_revenue]), SUM(daily_trip_metrics[trip_count]))",
            "formatString": "$#,0.00",
            "lineageTag": "d0d64901-0f48-40b6-91e6-9455c8294502"
          },
          {
            "name": "Avg Tip per Trip (USD)",
            "expression": "DIVIDE(SUM(daily_trip_metrics[total_tip_amount]), SUM(daily_trip_metrics[trip_count]))",
            "formatString": "$#,0.00",
            "lineageTag": "7332b20b-c3f7-422e-8844-b62463db0415"
          }
        ],
        "partitions": [
          {
            "name": "daily_trip_metrics",
            "mode": "import",
            "source": {
              "expression": [
                "let",
                "    Source = Csv.Document(File.Contents(CsvRootPath & \"\\\" & \"daily_trip_metrics.csv\"),[Delimiter=\",\", Columns=15, Encoding=1252, QuoteStyle=QuoteStyle.None]),",
                "    #\"Promoted Headers\" = Table.PromoteHeaders(Source, [PromoteAllScalars=true]),",
                "    #\"Changed Type\" = Table.TransformColumnTypes(#\"Promoted Headers\",{{\"pickup_date\", type date}, {\"trip_count\", Int64.Type}, {\"total_revenue\", type number}, {\"average_fare_amount\", type number}, {\"average_total_amount\", type number}, {\"average_trip_distance\", type number}, {\"average_trip_duration_minutes\", type number}, {\"total_trip_distance\", type number}, {\"average_tip_amount\", type number}, {\"total_tip_amount\", type number}, {\"_gold_processed_at\", type datetime}, {\"_source_taxi_type\", type text}, {\"_source_year\", Int64.Type}, {\"_source_month\", Int64.Type}, {\"_serving_published_at\", type datetime}})",
                "in",
                "    #\"Changed Type\""
              ],
              "type": "m"
            }
          }
        ]
      },
