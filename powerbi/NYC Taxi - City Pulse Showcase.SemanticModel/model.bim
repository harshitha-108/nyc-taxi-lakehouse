          {
            "name": "MonthKey",
            "dataType": "int64",
            "expression": "daily_trip_metrics[_source_year] * 100 + daily_trip_metrics[_source_month]",
            "formatString": "0",
            "isHidden": true,
            "lineageTag": "4c8727a7-12d7-4aa8-b6a3-c15cfca52ccb",
