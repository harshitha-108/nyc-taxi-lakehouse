                "    #\"Promoted Headers\" = Table.PromoteHeaders(Source, [PromoteAllScalars=true]),",
                "    #\"Changed Type\" = Table.TransformColumnTypes(#\"Promoted Headers\",{{\"payment_type\", Int64.Type}, {\"trip_count\", Int64.Type}, {\"total_revenue\", type number}, {\"average_total_amount\", type number}, {\"average_tip_amount\", type number}, {\"total_tip_amount\", type number}, {\"trip_percentage\", type number}, {\"revenue_percentage\", type number}, {\"_gold_processed_at\", type datetime}, {\"_source_taxi_type\", type text}, {\"_source_year\", Int64.Type}, {\"_source_month\", Int64.Type}, {\"_serving_published_at\", type datetime}})",
                "in",
                "    #\"Changed Type\""
              ],
              "type": "m"
            }
          }
        ]
