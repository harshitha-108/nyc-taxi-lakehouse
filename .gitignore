# Secrets and local configuration
.env
.env.*
!.env.example

# Python
__pycache__/
*.py[cod]
.pytest_cache/
.ruff_cache/
.ivy2/
.mypy_cache/
.coverage
coverage.xml
.venv/
venv/

# Data and runtime artefacts (directory placeholders are retained)
data/raw/*
!data/raw/.gitkeep
data/bronze/*
!data/bronze/.gitkeep
data/silver/*
!data/silver/.gitkeep
data/gold/*
!data/gold/.gitkeep
data/reference/*
!data/reference/.gitkeep
data/state/*
!data/state/.gitkeep
data/quarantine/*
!data/quarantine/.gitkeep
logs/
warehouse/
spark-warehouse/
metastore_db/
derby.log

# Docker and service state
volumes/
minio-data/
postgres-data/
airflow/logs/
airflow/plugins/__pycache__/

# IDE and operating-system files
.idea/
.vscode/
*.code-workspace
.DS_Store
Thumbs.db

# Power BI Desktop machine-specific settings and imported-data cache
**/.pbi/localSettings.json
**/.pbi/cache.abf
# Private, working PBIP copy created by the local City Pulse launcher
/powerbi/.local/
